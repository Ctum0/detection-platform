<group name="detection_platform_sigma,">

  
  <rule id="100001" level="10">
    <if_sid>80700</if_sid>
    <match type="pcre2">(?i)a0="(?:[^"]*/)?(?:nc|ncat|netcat|socat)"(?:\s+a\d+="[^"]*")*?\s+a[1-3]="-[a-z]*e"|a0="(?:[^"]*/)?(?:ba|da)?sh"\s+a1="-i"(?:\s+a\d+="[^"]*")*?\s+a\d+="[^"]*(?:/dev/tcp/|\x3e\x26)</match>
    <description>Netcat-family or interactive shell reverse-shell execution on Linux [T1059.004]</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>

  <rule id="100002" level="7">
    <if_sid>60109</if_sid>
    <description>Detection Platform: Local user account created (4720) [T1136.001]</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  
  <rule id="100003" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^(?:0x1010|0x1410|0x1438|0x143a|0x1fffff)$</field>
    <description>Detection Platform: Sensitive handle to LSASS - credential dumping pattern [T1003.001]</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  
  <rule id="100004" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)DownloadString|DownloadFile|Net\.WebClient|Invoke-WebRequest|Invoke-RestMethod|Start-BitsTransfer</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Invoke-Expression|IEX\(|IEX\ </field>
    <description>Detection Platform: PowerShell download cradle - fetch and execute pattern [T1059.001]</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  
  <rule id="100005" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-enc(od(edcommand)?)?\b|\s-EncodedCommand\b</field>
    <description>Detection Platform: PowerShell with encoded command [T1059.001]</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  
  <rule id="100006" level="7">
    <if_sid>60228</if_sid>
    <field name="win.system.eventID">^4698$</field>
    <description>Detection Platform: Scheduled task created (4698) [T1053.005]</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  
  <rule id="100007" level="10">
    <if_sid>63103</if_sid>
    <field name="win.system.eventID">^1102$</field>
    <description>Detection Platform: Windows Security event log cleared (1102) [T1685.005]</description>
    <mitre>
      <id>T1685.005</id>
    </mitre>
  </rule>

  
  <rule id="100008" level="5">
    <if_sid>5710, 5760</if_sid>
    <match>Failed password</match>
    <description>Detection Platform: SSH failed authentication [T1110.001]</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  
  <rule id="100009" level="10" frequency="6" timeframe="600">
    <if_matched_sid>100008</if_matched_sid>
    <same_source_ip />
    <description>Detection Platform: SSH brute force - 6+ failed auths from one source in 10m [T1110.001]</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  
  <rule id="100010" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.command" type="pcre2">(?i)chmod</field>
    <field name="audit.args" type="pcre2">(?i)u\+s|4755|4750|4777</field>
    <description>Detection Platform: chmod setting SUID bit [T1548.001]</description>
    <mitre>
      <id>T1548.001</id>
    </mitre>
  </rule>

  
  <rule id="100011" level="10">
    <if_group>windows_system</if_group>
    <field name="win.system.eventID">^7045$</field>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)\\Temp\\|\\Users\\Public\\|\\ProgramData\\|\\AppData\\|powershell|pwsh|\.ps1|\.vbs|\.hta</field>
    <description>Detection Platform: Service created with suspicious binary path [T1543.003]</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>

  <rule id="100012" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\notepad\.exe$</field>
    <description>Detection Platform: Notepad execution - CI/CD pipeline test [T1098]</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>
  <rule id="100013" level="0">
    <if_sid>92900</if_sid>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x101001$</field>
    <field name="win.eventdata.callTrace" type="pcre2">(?i)lsm\.dll</field>
    <description>LSASS access via lsm.dll with non-read GrantedAccess 0x101001 - benign Windows LSM path (FP for 92900)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>
  <rule id="100020" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)__PSScriptPolicyTest_[a-z0-9]+\.[a-z0-9]+\.ps1</field>
    <description>Detection Platform tuning: PowerShell script policy test file - benign, excluded from 92213</description>
  </rule>
</group>
